---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada · OHPIA" noindex>
  <section class="legal">
    <div class="wrap">
      <p class="eyebrow">Error 404</p>
      <h1>Esta página no existe.</h1>
      <p>Puede que el enlace esté mal o que la página se haya movido.</p>
      <a class="btn btn-navy back" href="/">Ir a la portada</a>
    </div>
  </section>
</Base>
